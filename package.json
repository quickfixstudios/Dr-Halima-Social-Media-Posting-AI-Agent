{
  "name": "dr-halima-social-agent",
  "version": "1.0.0",
  "description": "Daily women's-health content engine for Dr. Halima: Claude -> gpt-image-1 -> JSON store -> Buffer, with engagement-driven topic selection.",
  "type": "module",
  "main": "src/index.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/index.js cron",
    "run:daily": "node src/index.js run",
    "run:dry": "node src/index.js run --dry-run",
    "import": "node src/index.js import",
    "sync:engagement": "node src/index.js sync",
    "insights": "node src/index.js insights",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "dotenv": "^16.4.5",
    "luxon": "^3.7.2",
    "node-cron": "^4.6.0",
    "openai": "^7.27.0",
    "zod": "^4.6.5"
  }
}
