{
  "$comment": "Make.com scenario that publishes posts approved in the image review screen. NOT created in Make yet — see IMAGE_AUTOMATION.md §Make.com for the 6-step setup. 'hook' is filled in when you create the webhook in Make.",
  "scheduling": {
    "type": "immediately"
  },
  "blueprint": {
    "name": "Dr Halima – Publish approved image posts",
    "flow": [
      {
        "id": 1,
        "module": "gateway:CustomWebHook",
        "version": 1,
        "parameters": {
          "hook": null,
          "maxResults": 1
        },
        "mapper": {},
        "metadata": {
          "designer": {
            "x": 0,
            "y": 0
          }
        }
      },
      {
        "id": 2,
        "module": "builtin:BasicRouter",
        "version": 1,
        "parameters": {},
        "mapper": null,
        "metadata": {
          "designer": {
            "x": 300,
            "y": 0
          }
        },
        "routes": [
          {
            "flow": [
              {
                "id": 3,
                "module": "facebook-pages:CreatePostWithPhotos",
                "version": 6,
                "parameters": {
                  "__IMTCONN__": 11459922
                },
                "filter": {
                  "name": "Images sent as links (Cloudinary) — any number of photos",
                  "conditions": [
                    [
                      {
                        "a": "{{length(1.facebook_photos)}}",
                        "o": "number:greater",
                        "b": "0"
                      }
                    ]
                  ]
                },
                "mapper": {
                  "page_id": "103052652458065",
                  "message": "{{1.caption}}",
                  "date": "{{1.publish_at}}",
                  "photos": "{{1.facebook_photos}}"
                },
                "onerror": [
                  {
                    "id": 7,
                    "module": "builtin:Break",
                    "version": 1,
                    "parameters": {},
                    "mapper": {
                      "count": 3,
                      "retry": true,
                      "interval": 2
                    },
                    "metadata": {
                      "designer": {
                        "x": 0,
                        "y": 0
                      }
                    }
                  }
                ],
                "metadata": {
                  "designer": {
                    "x": 600,
                    "y": -150
                  }
                }
              },
              {
                "id": 4,
                "module": "gateway:WebhookRespond",
                "version": 1,
                "parameters": {},
                "mapper": {
                  "status": 200,
                  "body": "{\"fb_post_id\": \"{{3.id}}\"}"
                },
                "metadata": {
                  "designer": {
                    "x": 900,
                    "y": 0
                  }
                }
              }
            ]
          },
          {
            "flow": [
              {
                "id": 5,
                "module": "facebook-pages:CreatePostWithPhotos",
                "version": 6,
                "parameters": {
                  "__IMTCONN__": 11459922
                },
                "filter": {
                  "name": "Single image sent inline (base64)",
                  "conditions": [
                    [
                      {
                        "a": "{{length(1.facebook_photos)}}",
                        "o": "number:equal",
                        "b": "0"
                      }
                    ]
                  ]
                },
                "mapper": {
                  "page_id": "103052652458065",
                  "message": "{{1.caption}}",
                  "date": "{{1.publish_at}}",
                  "photos": [
                    {
                      "type": "data",
                      "fileName": "{{1.images[1].filename}}",
                      "data": "{{toBinary(1.images[1].base64; \"base64\")}}"
                    }
                  ]
                },
                "onerror": [
                  {
                    "id": 8,
                    "module": "builtin:Break",
                    "version": 1,
                    "parameters": {},
                    "mapper": {
                      "count": 3,
                      "retry": true,
                      "interval": 2
                    },
                    "metadata": {
                      "designer": {
                        "x": 0,
                        "y": 0
                      }
                    }
                  }
                ],
                "metadata": {
                  "designer": {
                    "x": 600,
                    "y": 150
                  }
                }
              },
              {
                "id": 6,
                "module": "gateway:WebhookRespond",
                "version": 1,
                "parameters": {},
                "mapper": {
                  "status": 200,
                  "body": "{\"fb_post_id\": \"{{5.id}}\"}"
                },
                "metadata": {
                  "designer": {
                    "x": 900,
                    "y": 0
                  }
                }
              }
            ]
          }
        ]
      }
    ],
    "metadata": {
      "instant": true,
      "version": 1,
      "scenario": {
        "dlq": true,
        "slots": null,
        "dataloss": false,
        "maxErrors": 3,
        "autoCommit": true,
        "roundtrips": 1,
        "sequential": false,
        "confidential": false,
        "freshVariables": false,
        "autoCommitTriggerLast": true
      },
      "designer": {
        "orphans": []
      }
    }
  }
}
