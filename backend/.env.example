# ---------- Server ----------
PORT=8080
# Make sends: Authorization: Bearer <BACKEND_API_KEY>
BACKEND_API_KEY=change-me-long-random-string

# ---------- OpenAI ----------
OPENAI_API_KEY=sk-...
TEXT_MODEL=gpt-6.1-sol
# gpt-image-1 is shut down by OpenAI on 2026-10-23 — switch IMAGE_MODEL to gpt-image-2 before then.
IMAGE_MODEL=gpt-image-1
IMAGE_MODEL_FALLBACK=gpt-image-2
IMAGE_QUALITY=high
CAROUSEL_SLIDE_IMAGES=false

# ---------- Media hosting (Instagram needs public URLs) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# ---------- Google Sheets (system of record) ----------
SPREADSHEET_ID=
# Service account JSON (one line) with Editor access to the spreadsheet
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ---------- Meta Graph API (engagement sync) ----------
GRAPH_API_VERSION=v23.0
META_PAGE_ACCESS_TOKEN=

# ---------- Behaviour ----------
TIMEZONE=Asia/Dhaka
SLOT_TIMES=10:00,13:00,16:00,19:00,22:00
REEL_SLOTS=slot2,slot4
# await_video | cover_only
REELS_MODE=await_video
# true = every post lands as needs_review until a human sets status=ready
APPROVAL_REQUIRED=false

# ---------- Alerts ----------
# Slack incoming webhook (or any endpoint accepting {"text": "..."})
ALERT_WEBHOOK_URL=
LOG_LEVEL=info

# ═════════════ Image automation (IMAGE_AUTOMATION.md) ═════════════
# Models — change here, never in code. OPENAI_API_KEY above is reused.
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_TEXT_MODEL=gpt-6.1-sol
# true for gpt-image-2 family (any size divisible by 16); false for older models (3 fixed sizes)
IMAGE_MODEL_ARBITRARY_SIZES=true
IMAGE_QUALITY=high
IMAGE_TIMEOUT_MS=180000
IMAGE_RETRIES=3

# true = never call OpenAI; show the brief, prompt and a text preview instead (free)
IMAGE_GENERATION_DRY_RUN=false
# overlay = Pipeline A (we draw the Bangla text — recommended) · model = Pipeline B (AI draws text — experimental)
IMAGE_TEXT_MODE=overlay
# true = let the text model shorten a too-long headline (shown to the reviewer as "derived")
IMAGE_TEXT_SHORTEN_WITH_LLM=false
IMAGE_DEFAULT_BUSINESS=dr_halima
# v2 = the existing daily run uses this reviewed image pipeline instead of the old one
IMAGE_PIPELINE=v1

# Cost controls (USD budgets use backend/config/image-pricing.json — fill in current prices there)
MAX_IMAGE_GENERATIONS_PER_POST=6
MAX_REGENERATIONS=3
DAILY_IMAGE_GENERATION_LIMIT=25
DAILY_IMAGE_BUDGET=
MONTHLY_IMAGE_BUDGET=

# Review screen (npm run review). Leave REVIEW_HOST as 127.0.0.1 = only this computer can open it.
REVIEW_HOST=127.0.0.1
REVIEW_PORT=8091
REVIEW_PASSWORD=

# Make.com webhook of the "Publish approved image posts" scenario (one per business; keep secret)
MAKE_WEBHOOK_URL_DR_HALIMA=
MAKE_WEBHOOK_URL_QUICKFIX_STUDIOS=
# auto = links via Cloudinary when configured, otherwise the image bytes inside the webhook (single images only)
MAKE_IMAGE_DELIVERY=auto

# Optional folder overrides (defaults: <repo>/brands, <repo>/posts, <repo>/assets)
# BRANDS_DIR=
# POSTS_DIR=
# ASSETS_DIR=
