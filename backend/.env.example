# ---------- Server ----------
PORT=8080
# Make sends: Authorization: Bearer <BACKEND_API_KEY>
BACKEND_API_KEY=change-me-long-random-string

# ---------- OpenAI ----------
OPENAI_API_KEY=sk-...
TEXT_MODEL=gpt-6.1-sol
# gpt-image-1 is shut down by OpenAI on 2026-10-23 — switch IMAGE_MODEL to gpt-image-2 before then.
IMAGE_MODEL=gpt-image-1
IMAGE_MODEL_FALLBACK=gpt-image-2
IMAGE_QUALITY=high
CAROUSEL_SLIDE_IMAGES=false

# ---------- Media hosting (Instagram needs public URLs) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# ---------- Google Sheets (system of record) ----------
SPREADSHEET_ID=
# Service account JSON (one line) with Editor access to the spreadsheet
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ---------- Meta Graph API (engagement sync) ----------
GRAPH_API_VERSION=v23.0
META_PAGE_ACCESS_TOKEN=

# ---------- Behaviour ----------
TIMEZONE=Asia/Dhaka
SLOT_TIMES=10:00,13:00,16:00,19:00,22:00
REEL_SLOTS=slot2,slot4
# await_video | cover_only
REELS_MODE=await_video
# true = every post lands as needs_review until a human sets status=ready
APPROVAL_REQUIRED=false

# ---------- Alerts ----------
# Slack incoming webhook (or any endpoint accepting {"text": "..."})
ALERT_WEBHOOK_URL=
LOG_LEVEL=info
