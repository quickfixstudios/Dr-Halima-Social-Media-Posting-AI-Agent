{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "content-record.schema.json",
  "title": "Stored content record (one row of the Content sheet / content table)",
  "type": "object",
  "required": ["id", "date", "scheduled_slot", "scheduled_at", "post_type", "content_pillar", "topic", "status"],
  "properties": {
    "id": { "type": "string" },
    "date": { "type": "string", "format": "date" },
    "scheduled_slot": { "enum": ["slot1", "slot2", "slot3", "slot4", "slot5"] },
    "scheduled_at": { "type": "string", "format": "date-time", "description": "ISO 8601 with +06:00 offset" },
    "post_type": { "enum": ["reel", "image", "carousel"] },
    "content_pillar": { "type": "string" },
    "topic": { "type": "string" },
    "hook_pattern": { "type": "string" },
    "content_goal": { "type": "string" },
    "hook_english": { "type": "string" },
    "hook_bangla_short": { "type": "string" },
    "caption": { "type": "string" },
    "hashtags": { "type": "string", "description": "space-separated" },
    "cta": { "type": "string" },
    "script": { "type": "string" },
    "video_storyboard_json": { "type": "string", "description": "JSON-encoded array" },
    "carousel_slides_json": { "type": "string", "description": "JSON-encoded array" },
    "visual_prompt": { "type": "string" },
    "image_urls": { "type": "string", "description": "comma-separated public URLs, cover first" },
    "video_url": { "type": "string" },
    "status": { "enum": ["generated", "ready", "awaiting_video", "needs_review", "publishing", "published", "failed", "skipped"] },
    "compliance_status": { "enum": ["pass", "fix_applied", "block"] },
    "compliance_notes": { "type": "string" },
    "ig_media_id": { "type": "string" },
    "fb_post_id": { "type": "string" },
    "published_at": { "type": "string" },
    "likes": { "type": "integer" },
    "comments": { "type": "integer" },
    "shares": { "type": "integer" },
    "saves": { "type": "integer" },
    "reach": { "type": "integer" },
    "engagement_score": { "type": "number" },
    "metrics_updated_at": { "type": "string" },
    "retry_count": { "type": "integer" },
    "last_error": { "type": "string" },
    "run_id": { "type": "string" }
  }
}
