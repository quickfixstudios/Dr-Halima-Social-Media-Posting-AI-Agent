# ---------- Claude (content generation) ----------
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high

# ---------- OpenAI (visuals) ----------
OPENAI_API_KEY=sk-...
OPENAI_IMAGE_MODEL=gpt-image-1
# low | medium | high
OPENAI_IMAGE_QUALITY=high
# Also render one image per carousel slide (5x image cost per carousel)
CAROUSEL_SLIDE_IMAGES=false

# ---------- Media hosting (Buffer needs a public image URL) ----------
# "cloudinary" (recommended) or "static" (you serve data/media yourself, e.g. S3/Nginx)
MEDIA_HOST=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
# Used when MEDIA_HOST=static, e.g. https://cdn.example.com/media
PUBLIC_MEDIA_BASE_URL=

# ---------- Buffer ----------
BUFFER_ACCESS_TOKEN=
# Comma-separated Buffer profile IDs (Instagram, Facebook, TikTok, ...)
BUFFER_PROFILE_IDS=
BUFFER_API_BASE=https://api.bufferapp.com/1
# Reels need a real video file. "await_video" = hold reels until video_url is set;
# "cover_image" = publish the reel cover image + caption as a teaser post.
REELS_MODE=await_video

# ---------- Scheduling ----------
TIMEZONE=Asia/Dhaka
POST_TIMES=10:00,13:00,16:00,19:00,22:00
# Daily generation cron (in TIMEZONE) and engagement sync cron
GENERATE_CRON=15 6 * * *
ENGAGEMENT_CRON=30 23 * * *

# ---------- Alerts ----------
# Slack/Discord/any webhook that accepts {"text"} or {"content"}
ALERT_WEBHOOK_URL=

# ---------- Storage / logging ----------
DATA_DIR=./data
LOG_LEVEL=info
