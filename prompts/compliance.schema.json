{
  "type": "json_schema",
  "name": "compliance_review",
  "strict": true,
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "reviews"
    ],
    "properties": {
      "reviews": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "verdict",
            "issues",
            "suggested_fix"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "verdict": {
              "type": "string",
              "enum": [
                "pass",
                "fix",
                "block"
              ]
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "suggested_fix": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "caption",
                "script",
                "carousel_slides_text"
              ],
              "properties": {
                "caption": {
                  "type": "string",
                  "description": "Corrected caption, or empty string if unchanged."
                },
                "script": {
                  "type": "string",
                  "description": "Corrected script, or empty string if unchanged."
                },
                "carousel_slides_text": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Corrected slide bodies in order, or empty array if unchanged."
                }
              }
            }
          }
        }
      }
    }
  }
}
