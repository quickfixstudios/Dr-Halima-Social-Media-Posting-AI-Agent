{
  "type": "json_schema",
  "name": "daily_batch",
  "strict": true,
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "daily_batch"
    ],
    "properties": {
      "daily_batch": {
        "type": "array",
        "description": "Exactly 5 posts ordered slot1 to slot5.",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "scheduled_slot",
            "post_type",
            "content_pillar",
            "topic",
            "hook_pattern",
            "content_goal",
            "hook_english",
            "hook_bangla_short",
            "script",
            "video_storyboard",
            "caption",
            "visual_prompt",
            "carousel_slides",
            "hashtags",
            "cta"
          ],
          "properties": {
            "id": {
              "type": "string",
              "description": "<run_date>-<slot number>"
            },
            "scheduled_slot": {
              "type": "string",
              "enum": [
                "slot1",
                "slot2",
                "slot3",
                "slot4",
                "slot5"
              ]
            },
            "post_type": {
              "type": "string",
              "enum": [
                "reel",
                "image",
                "carousel"
              ]
            },
            "content_pillar": {
              "type": "string",
              "enum": [
                "Education",
                "Myth vs Fact",
                "Warning/Awareness",
                "Pregnancy",
                "Hormonal Health",
                "Emotional Support",
                "Preventive Tips"
              ]
            },
            "topic": {
              "type": "string",
              "description": "Short topic label used for anti-repetition and learning."
            },
            "hook_pattern": {
              "type": "string",
              "enum": [
                "Curiosity",
                "Relatability",
                "Myth-breaking",
                "Gentle warning",
                "Reassurance"
              ]
            },
            "content_goal": {
              "type": "string",
              "enum": [
                "save-worthy",
                "share-worthy",
                "authority-building"
              ]
            },
            "hook_english": {
              "type": "string"
            },
            "hook_bangla_short": {
              "type": "string"
            },
            "script": {
              "type": "string",
              "description": "Full voiceover for reels; empty string otherwise."
            },
            "video_storyboard": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "start_s",
                  "end_s",
                  "section",
                  "visual",
                  "voiceover",
                  "on_screen_text"
                ],
                "properties": {
                  "start_s": {
                    "type": "number"
                  },
                  "end_s": {
                    "type": "number"
                  },
                  "section": {
                    "type": "string",
                    "enum": [
                      "Hook",
                      "Explanation",
                      "Insight",
                      "CTA"
                    ]
                  },
                  "visual": {
                    "type": "string"
                  },
                  "voiceover": {
                    "type": "string"
                  },
                  "on_screen_text": {
                    "type": "string"
                  }
                }
              }
            },
            "caption": {
              "type": "string"
            },
            "visual_prompt": {
              "type": "string"
            },
            "carousel_slides": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "slide_number",
                  "headline",
                  "body",
                  "visual_direction"
                ],
                "properties": {
                  "slide_number": {
                    "type": "integer"
                  },
                  "headline": {
                    "type": "string"
                  },
                  "body": {
                    "type": "string"
                  },
                  "visual_direction": {
                    "type": "string"
                  }
                }
              }
            },
            "hashtags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "cta": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
